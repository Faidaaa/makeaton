# Brightloop Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Shared MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/brightloop?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/brightloop?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / SMTP Configuration (for password reset)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Admin Seed Credentials (for npm run seed:admin)
ADMIN_EMAIL=admin@brightloop.com
ADMIN_PASSWORD=Admin@12345
